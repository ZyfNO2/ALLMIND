{
  "manifest_version": 3,
  "name": "AIKI Chat Bridge",
  "version": "0.1.0",
  "description": "Connect AIKI to a browser-owned ChatGPT conversation without CDP or terminal commands.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1:17643/*", "https://chatgpt.com/*"],
  "background": { "service_worker": "background.mjs", "type": "module" },
  "options_page": "options.html",
  "action": { "default_title": "AIKI Chat Bridge" },
  "content_scripts": [
    { "matches": ["https://chatgpt.com/*"], "js": ["page.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["https://chatgpt.com/*"], "js": ["content.js"], "run_at": "document_start" }
  ]
}
